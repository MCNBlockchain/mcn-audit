[Unit]
Description=MCN beacon
Wants=network-online.target
After=network-online.target mcn-geth.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/run-beacon.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGINT
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
