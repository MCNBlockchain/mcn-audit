[Unit]
Description=MCN geth
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/run-geth.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGINT
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
